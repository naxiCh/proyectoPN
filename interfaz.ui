  <property name="styleSheet">
   <string notr="true">/* ==========================================================================
   1. VENTANA PRINCIPAL
   ========================================================================== */
QMainWindow, QWidget#centralwidget {
    background-color: #FFFFFF;
    font-family: 'Segoe UI', -apple-system, Arial, sans-serif;
}

QWidget#franjaMalla, QWidget#franjaBotones, QWidget#franjaResultados_2,
QWidget#franjaSuperiorC, QWidget#franjaMediaC, QWidget#franjaInferiorC,
QWidget#malla, QWidget#tab_3, QWidget#tab {
    background-color: transparent;
}

/* ==========================================================================
   2. BARRA LATERAL IZQUIERDA (&gt; Labery)
   ========================================================================== */
QWidget#sidebar {
    background-color: #F1FAEE;
    border-right: 1.5px solid #A8DADC;
    min-width: 145px; /* Evita que el layout principal aplaste la barra */
}

QWidget#sidebar QLabel {
    color: #1D3557;
    font-size: 16px;
    font-weight: 700;
    padding-top: 25px;
    padding-left: 18px;
}

/* ==========================================================================
   3. PESTAÑAS SUPERIORES (Cápsula ovalada recuperada)
   ========================================================================== */
QTabWidget::pane {
    border: none;
    background-color: #FFFFFF;
    margin-top: 12px;
}

QTabWidget::tab-bar {
    alignment: center;
}

QTabBar::tab {
    background: transparent;
    color: #457B9D;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 22px;
    margin-right: 8px;
    border: none;
    border-radius: 15px;
    min-height: 18px; /* Necesario para que Qt no dibuje un rectángulo */
}

QTabBar::tab:selected {
    background-color: #1D3557;
    color: #F1FAEE;
    font-weight: 700;
    border-radius: 15px;
}

QTabBar::tab:hover:!selected {
    background-color: #F1FAEE;
    color: #1D3557;
}

QTabBar::tab:first {
    margin-left: 25px;
}

/* ==========================================================================
   4. ETIQUETAS GENERALES
   ========================================================================== */
QLabel {
    color: #1D3557;
    font-size: 12px;
    font-weight: 600;
}

/* ==========================================================================
   5. SELECTORES DESPLEGABLES (QComboBox) - Sin bloqueos de tamaño
   ========================================================================== */
QComboBox, QSpinBox {
    background-color: #F1FAEE;
    color: #1D3557;
    border: 1px solid #A8DADC;
    border-bottom: 2px solid #457B9D;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
}

QComboBox:hover {
    background-color: #FFFFFF;
    border-color: #457B9D;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #1D3557;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1D3557;
    border: 1px solid #457B9D;
    selection-background-color: #1D3557;
    selection-color: #F1FAEE;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

/* ==========================================================================
   6. CAMPOS DE TEXTO (QLineEdit) - Sin bloqueos de tamaño
   ========================================================================== */
QLineEdit {
    background-color: #F1FAEE;
    color: #1D3557;
    border: 1px solid #A8DADC;
    border-bottom: 2px solid #A8DADC;
    border-radius: 6px;
    padding: 0px 8px;
    font-size: 12px;
}

QLineEdit:focus {
    background-color: #FFFFFF;
    border: 1.5px solid #457B9D;
}

QLineEdit#lineL, QLineEdit#lineU {
    qproperty-alignment: AlignCenter;
}

QLineEdit:read-only,
QLineEdit#lineRedondeo:read-only, 
QLineEdit#lineTruncamiento:read-only,
QLineEdit#lineResultadoC:read-only,
QLineEdit#lineAbsoluto:read-only,
QLineEdit#lineRelativo:read-only {
    background-color: #EBF5F5;
    color: #1D3557;
    border: 1px solid #A8DADC;
    font-weight: 600;
}

/* ==========================================================================
   7. BOTONES DE ACCIÓN PRINCIPALES - Sin bloqueos de tamaño
   ========================================================================== */
QPushButton {
    background-color: #FFFFFF;
    color: #1D3557;
    border: 1.5px solid #457B9D;
    border-bottom: 3px solid #1D3557;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 2px 8px;
}

QPushButton:hover {
    background-color: #457B9D;
    color: #F1FAEE;
    border-color: #1D3557;
}

QPushButton:pressed {
    background-color: #1D3557;
    color: #F1FAEE;
    border-bottom: 1.5px solid #1D3557;
}

/* ==========================================================================
   8. BOTONES DE MÉTRICAS DE MALLA (Pestaña 2)
   ========================================================================== */
QPushButton#btnMenor, QPushButton#btnMayor, 
QPushButton#btnNumero, QPushButton#btnDistancia {
    background-color: #A8DADC;
    color: #1D3557;
    font-size: 11px;
    font-weight: 600;
    border: 1px solid #89C2C5;
    border-bottom: 3px solid #457B9D;
    border-radius: 12px;
    padding: 2px 4px;
    text-align: center;
}

QPushButton#btnMenor:hover, QPushButton#btnMayor:hover, 
QPushButton#btnNumero:hover, QPushButton#btnDistancia:hover {
    background-color: #457B9D;
    color: #F1FAEE;
    border-color: #1D3557;
}

/* ==========================================================================
   9. TARJETAS INFORMATIVAS Y DE ALERTA
   ========================================================================== */
QFrame#frmAclaraciones, QFrame#frameCalculadora {
    background-color: #F1FAEE;
    border: 1px solid #A8DADC;
    border-bottom: 3px solid #457B9D;
    border-radius: 10px;
}

QLabel#lblAclaraciones, QLabel#lblFrameC {
    color: #1D3557;
    font-size: 11px;
    font-weight: 500;
}

QFrame#frameAlerta {
    background-color: #FFF5F5;
    border: 1.5px solid #E63946;
    border-bottom: 3px solid #E63946;
    border-radius: 10px;
    padding: 6px;
}

QFrame#frameAlerta QLabel {
    color: #E63946;
    font-size: 11px;
    font-weight: 600;
}

/* ==========================================================================
   10. BOTONES DE OPERACIÓN Y COPIAR (QToolButton)
   ========================================================================== */
QToolButton#btnSumar, QToolButton#btnRestar, 
QToolButton#btnMultiplicar, QToolButton#btnDividir {
    background-color: #F1FAEE;
    color: #1D3557;
    border: 1.5px solid #A8DADC;
    border-bottom: 3px solid #457B9D;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
}

QToolButton#btnSumar:hover, QToolButton#btnRestar:hover, 
QToolButton#btnMultiplicar:hover, QToolButton#btnDividir:hover {
    background-color: #A8DADC;
    border-color: #1D3557;
}

QToolButton#btnSumar:checked, QToolButton#btnRestar:checked, 
QToolButton#btnMultiplicar:checked, QToolButton#btnDividir:checked {
    background-color: #1D3557;
    color: #F1FAEE;
    border-color: #1D3557;
}

QToolButton:!checked {
    background-color: #F1FAEE;
    border: 1px solid #A8DADC;
    border-radius: 6px;
    color: #1D3557;
}

QToolButton:!checked:hover {
    background-color: #A8DADC;
    border-color: #457B9D;
}</string>

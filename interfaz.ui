  <property name="styleSheet">
   <string notr="true">/* ==========================================================================
   VENTANA PRINCIPAL
   ========================================================================== */
QMainWindow, QWidget#centralwidget {
    background-color: #FFFFFF;
    font-family: 'Segoe UI', -apple-system, Arial, sans-serif;
}

/* ==========================================================================
   BARRA LATERAL IZQUIERDA (&gt; Labery)
   ========================================================================== */
QWidget#sidebar {
    background-color: #F1F2F4;
    border-right: 1px solid #E2E4E8;
    min-width: 140px;
    max-width: 150px;
}

QWidget#sidebar QLabel {
    color: #2D3142;
    font-size: 16px;
    font-weight: 700;
    padding-top: 25px;
    padding-left: 18px;
}

/* ==========================================================================
   PESTAÑAS SUPERIORES (Cápsula ovalada idéntica a Figma)
   ========================================================================== */
QTabWidget::pane {
    border: none;
    background-color: #FFFFFF;
    /* Separación extra entre la línea de pestañas y el contenido de abajo */
    margin-top: 15px; 
}

QTabWidget::tab-bar {
    left: 10px;
    alignment: center;
}

/* Pestañas inactivas: texto plano con respiración lateral */
QTabBar::tab {
    background: transparent;
    color: #4A4E69;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 24px;
    margin-right: 8px;
    border: none;
    border-radius: 17px;
    min-height: 18px;
}

/* Pestaña activa: Cápsula sólida violeta redondeada */
QTabBar::tab:selected {
    background-color: #4D4566;
    color: #FFFFFF;
    font-weight: 600;
    border-radius: 17px;
}

QTabBar::tab:hover:!selected {
    background-color: #F4F4F6;
    color: #22223B;
}

/* ==========================================================================
   ETIQUETAS GENERALES
   ========================================================================== */
QLabel {
    color: #2B2D42;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 4px;
}

/* ==========================================================================
   SELECTORES DESPLEGABLES (Base origen, Base destino, Precisión)
   ========================================================================== */
QComboBox, QSpinBox {
    background-color: #E2E4E8;
    color: #22223B;
    border: none;
    border-radius: 6px;
    padding: 6px 14px 6px 12px;
    font-size: 12px;
    min-height: 22px;
    min-width: 75px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #4A4E69;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D0D5DD;
    selection-background-color: #4D4566;
    selection-color: #FFFFFF;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

/* ==========================================================================
   CAMPO DE TEXTO DEL NÚMERO A CONVERTIR
   ========================================================================== */
QLineEdit#lineNumero, QLineEdit#lineRedondeo, QLineEdit#lineTruncamiento {
    background-color: #E2E4E8;
    color: #22223B;
    border: 1px solid #D8DCE0;
    border-radius: 6px;
    padding: 1px 5px;        /* Reduce el padding vertical a 2px */
    font-size: 13px;
    min-height: 5px;         /* Garantiza espacio vertical suficiente */
}

QLineEdit:focus {
    background-color: #FFFFFF;
    border: 1.5px solid #4D4566;
}

/* ==========================================================================
   BOTÓN CONVERTIR / CALCULAR
   ========================================================================== */
QPushButton#btnCalcular, QPushButton {
    background-color: #FFFFFF;
    color: #22223B;
    border: 1.5px solid #DCDFE4;
    border-radius: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

QPushButton:hover {
    background-color: #F8F9FA;
    border-color: #B0B5BD;
}

QPushButton:pressed {
    background-color: #ECEFF1;
}

/* ==========================================================================
   BOTONES DE COPIAR RESULTADO (📋)
   ========================================================================== */
QToolButton {
    background-color: transparent;
    border: 1px solid #DCDFE4;
    border-radius: 6px;
    padding: 5px 8px;
    color: #4A4E69;
    font-size: 12px;
}

QToolButton:hover {
    background-color: #F0F1F5;
    border-color: #B0B5BD;
}

/* ==========================================================================
   TARJETA ROJA DE ADVERTENCIA
   ========================================================================== */
QFrame#frameAlerta {
    background-color: #FFFFFF;
    border: 1.5px solid #EF4444;
    border-radius: 10px;
    padding: 10px 14px;
    max-width: 320px;
    margin-right: 10px;
}

QFrame#frameAlerta QLabel {
    color: #1F2937;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:first {
    margin-left: 125px; /* Subí este número (ej: 80px, 120px) para moverlas más al medio */
}

/* ==========================================================================
   PESTAÑA: CÁLCULO DE MALLA (tab_2 / malla)
   ========================================================================== */
QWidget#malla {
    background-color: #FFFFFF;
}

/* Contenedores interiores transparentes */
QWidget#franjaMalla, QWidget#franjaBotones, QWidget#franjaResultados_2 {
    background-color: transparent;
}

/* Tarjeta explicativa teórica (B, t, L, U) */
QFrame#frmAclaraciones {
    background-color: #FAFAFB;
    border: 1px solid #DCE0E5;
    border-radius: 8px;
}

QLabel#lblAclaraciones {
    color: #4A4E69;
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
}

/* Títulos de sección */
QLabel#lblParametros, QLabel#lblARepresentar, QLabel#lblRedondeo, QLabel#lblTruncamiento {
    color: #22223B;
    font-size: 12px;
    font-weight: 600;
}

/* ==========================================================================
   LAS 4 TARJETAS / BOTONES DE MÉTRICAS (menor, mayor, cant, distancia)
   ========================================================================== */
QPushButton#btnMenor, QPushButton#btnMayor, QPushButton#btnNumero, QPushButton#btnDistancia {
    background-color: #E2E4E8;
    color: #4A4E69;
    font-size: 11px;
    font-weight: 600;
    border: none;
    border-radius: 12px;
    padding: 6px 8px;
    text-align: center;
}

QPushButton#btnMenor:hover, QPushButton#btnMayor:hover, 
QPushButton#btnNumero:hover, QPushButton#btnDistancia:hover {
    background-color: #D4D8DE;
    color: #22223B;
}

/* ==========================================================================
   CAMPOS DE TEXTO Y BOTÓN REPRESENTAR
   ========================================================================== */
QLineEdit#lineNumero, QLineEdit#lineRedondeo, QLineEdit#lineTruncamiento {
    background-color: #E2E4E8;
    color: #22223B;
    border: 1px solid #D8DCE0;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
}

/* Campos de resultados como sólo lectura en gris claro */
QLineEdit#lineRedondeo:read-only, QLineEdit#lineTruncamiento:read-only {
    background-color: #ECECF0;
    color: #4D4566;
    font-weight: 600;
}

QPushButton#btnRepresentar {
    background-color: #FFFFFF;
    color: #22223B;
    border: 1.5px solid #DCDFE4;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#btnRepresentar:hover {
    background-color: #F8F9FA;
    border-color: #B0B5BD;
}</string>
